# go_file configuration -- copy to .env and edit. Never commit .env.
# Everything here is read from the process environment (twelve-factor).

# --- identity ---------------------------------------------------------------
APP_ENV=development
# Required when APP_ENV=production; the app refuses to start without it.
SECRET_KEY=change-me-in-production

# --- HTTP -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
MAX_CONTENT_LENGTH=8388608

# --- storage ----------------------------------------------------------------
# Leave empty to use the bundled sqlite database under var/instance.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/go_file
DATA_DIR=
INSTANCE_DIR=
LOG_DIR=

# --- observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
REQUEST_ID_HEADER=X-Request-ID

# --- application-specific ---------------------------------------------------
# Variables the application modules read directly. They are listed here so an
# operator can discover the whole surface in one place; Settings.extras
# reports whichever of them are set.
#
# Every path variable above also accepts a GO_FILE_-prefixed spelling
# (GO_FILE_DATA_DIR, GO_FILE_INSTANCE_DIR, GO_FILE_LOG_DIR,
# GO_FILE_UPLOAD_ROOT). When both are set, the prefixed one wins.
UPLOAD_ROOT=
# GOFILE_URL is read by the CLI, not by the web process.
GOFILE_URL=http://127.0.0.1:8000
ANALYTICS_SALT=change-me-in-production
